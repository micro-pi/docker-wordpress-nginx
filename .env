# ============================================================================
# Docker WordPress + Nginx + MariaDB Environment Configuration
# ============================================================================
# Copy this file to .env and customize with your own values
# DO NOT commit the .env file to version control
# ============================================================================

# NGINX Configuration
# Port where Nginx will be accessible on the host machine
NGINX_PORT=8081

# MariaDB / MySQL Configuration
# Root password for MariaDB (used for initial setup)
# SECURITY WARNING: Use a strong, random password for production
MYSQL_ROOT_PASSWORD=root_password_change_me

# Database name for WordPress
MYSQL_DATABASE=wordpress_db

# Database user for WordPress (will be created if not exists)
MYSQL_USER=wordpress_user

# Database password for WordPress user
# SECURITY WARNING: Use a strong, random password for production
MYSQL_PASSWORD=wordpress_password_change_me

# Database port exposed on host (for external access via Adminer/tools)
# Only binds to 127.0.0.1 for local connections, not publicly exposed
DB_PORT=3307

# Adminer Configuration
# Port where Adminer (database GUI) will be accessible
# http://localhost:8181
ADMINER_PORT=8181

# ============================================================================
# WORDPRESS CONFIGURATION (Environment-agnostic defaults)
# ============================================================================
# These values should match MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD
WORDPRESS_DB_NAME=${MYSQL_DATABASE}
WORDPRESS_DB_USER=${MYSQL_USER}
WORDPRESS_DB_PASSWORD=${MYSQL_PASSWORD}
WORDPRESS_DB_HOST=db
WORDPRESS_DB_CHARSET=utf8mb4
WORDPRESS_DB_COLLATE=utf8mb4_unicode_ci

# ============================================================================
# COMPOSE_PROJECT_NAME
# ============================================================================
# Optional: Set a custom project name for Docker containers
# Useful when running multiple instances of this stack
# COMPOSE_PROJECT_NAME=my_wordpress_project
